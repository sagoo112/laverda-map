{
  "expo": {
    "name": "laverda-map",
    "slug": "laverda-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/laverda-app-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f4ee"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show nearby Laverda places only when you choose Near me."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/laverda-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.laverdamap"
    },
    "web": {
      "favicon": "./assets/laverda-app-icon.png"
    },
    "extra": {
      "mapsAndroidConfigured": false,
      "eas": {
        "projectId": "fdc1c47a-7194-47f2-8d98-06e33114a985"
      }
    },
    "owner": "goodsa"
  }
}
