{
  "cli": {
    "version": ">= 27.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "24.13.0",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "24.13.0",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "node": "24.13.0",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "play-test": {
      "extends": "production",
      "environment": "preview",
      "android": {
        "env": {
          "EXPO_PUBLIC_API_URL": "https://api.laverdaclub.ch"
        }
      }
    }
  }
}
